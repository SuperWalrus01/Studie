{
  "name": "busapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-gtfs-bundle.mjs",
    "build": "next build",
    "bundle-gtfs": "npx tsx --env-file=.env.local scripts/prebuild-gtfs-download.mjs",
    "start": "next start",
    "lint": "eslint",
    "verify-stops": "node --env-file=.env.local scripts/verify-stops.mjs",
    "rebuild-cache": "NODE_OPTIONS=--max-old-space-size=8192 npx tsx --env-file=.env.local scripts/rebuild-cache.mjs",
    "route-stats": "npx tsx --env-file=.env.local scripts/generate-route-stats.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "gtfs-realtime-bindings": "^1.1.1",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
